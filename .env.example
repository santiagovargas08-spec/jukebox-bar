# Base de datos PostgreSQL
DATABASE_URL=

# SSL para PostgreSQL en Render (true en producción)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# API comercial LEGACY. Deshabilitada por defecto.
# Habilitar SOLO si una integración externa aún depende de /api/commercial.
ENABLE_LEGACY_COMMERCIAL_API=false
ADMIN_API_KEY=

# Secreto para firmar tokens de operadores BAR_ADMIN / DJ / OPERATOR (mínimo 32 caracteres)
# Genera uno seguro: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OPERATOR_TOKEN_SECRET=

# Secreto independiente para SUPER_ADMIN (mínimo 32 caracteres).
# Debe configurarse en Render y en desarrollo si se usa Master Admin.
MASTER_ADMIN_TOKEN_SECRET=

# Credenciales usadas SOLO por create-master-admin.js para el bootstrap inicial.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_PASSWORD=

# URL pública de la app (CORS y links/QR en producción)
APP_URL=

# Puerto (Render lo asigna automáticamente)
PORT=3000

# Base de datos separada para tests (nunca usar producción)
TEST_DATABASE_URL=

# Términos de canciones bloqueados (opcional, separados por coma)
# BLOCKED_SONG_TERMS=
