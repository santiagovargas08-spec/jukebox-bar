# Base de datos PostgreSQL
DATABASE_URL=

# SSL para PostgreSQL en Render (true en producción)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Clave de administrador para /api/commercial y panel comercial
# Genera una clave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Secreto para firmar tokens de operador (mínimo 32 caracteres)
# Genera uno seguro: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OPERATOR_TOKEN_SECRET=

# Secreto independiente recomendado para SUPER_ADMIN (mínimo 32 caracteres).
# Si se deja vacío, el backend usa OPERATOR_TOKEN_SECRET como fallback.
MASTER_ADMIN_TOKEN_SECRET=

# Credenciales usadas SOLO por create-master-admin.js para el bootstrap inicial.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_PASSWORD=

# URL pública de la app (CORS y links en producción)
APP_URL=

# Puerto (Render lo asigna automáticamente)
PORT=3000

# Base de datos separada para tests (nunca usar producción)
TEST_DATABASE_URL=

# Términos de canciones bloqueados (opcional, separados por coma)
# BLOCKED_SONG_TERMS=
